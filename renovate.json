{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OpenTofu from the shared version file",
      "managerFilePatterns": [
        "/^\\.opentofu-version$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"
      ],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update the annotated Tailscale GitHub Action version",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/ci\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=tailscale/tailscale versioning=semver extractVersion=\\^v\\(\\?<version>\\.\\*\\)\\$\\s+version: \\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""
      ],
      "depNameTemplate": "tailscale/tailscale",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update the VueTorrent LinuxServer Docker mod",
      "managerFilePatterns": [
        "/^apps\\/compose\\/homelab\\/compose\\.yml$/"
      ],
      "matchStrings": [
        "DOCKER_MODS: ghcr.io/vuetorrent/vuetorrent-lsio-mod:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ghcr.io/vuetorrent/vuetorrent-lsio-mod",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update Debian 13 Proxmox LXC template versions in the production topology",
      "managerFilePatterns": [
        "/^infra\\/ansible\\/inventory\\/prod\\/topology\\.json$/"
      ],
      "matchStrings": [
        "\\\"template_file_id\\\"\\s*:\\s*\\\"local:vztmpl/debian-13-standard_(?<currentValue>[^_]+)_amd64\\.tar\\.zst\\\""
      ],
      "depNameTemplate": "proxmox-debian-13",
      "datasourceTemplate": "custom.proxmox-debian-13",
      "versioningTemplate": "loose"
    }
  ],
  "customDatasources": {
    "proxmox-debian-13": {
      "defaultRegistryUrlTemplate": "https://download.proxmox.com/images/system/",
      "format": "html"
    }
  },
  "packageRules": [
    {
      "matchDatasources": ["custom.proxmox-debian-13"],
      "extractVersion": "^debian-13-standard_(?<version>.+)_amd64\\.tar\\.zst$"
    },
    {
      "description": "Order MeTube calendar-versioned Docker tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/alexta69/metube"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{2})\\.(?<patch>\\d{2})$"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Require review for OpenClaw",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/openclaw/openclaw"],
      "automerge": false,
      "platformAutomerge": false
    }
  ]
}
