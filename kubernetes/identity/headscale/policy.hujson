{
  "tagOwners": {
    "tag:gateway": []
  },
  "grants": [
    {
      "src": ["autogroup:member"],
      "dst": ["autogroup:member", "${LAN_CIDR}", "tag:gateway", "autogroup:internet"],
      "ip": ["*"]
    }
  ],
  "autoApprovers": {
    "routes": {"${LAN_CIDR}": ["tag:gateway"]},
    "exitNode": ["tag:gateway"]
  }
}
