# Track portable profile state only.
*
!/.gitignore
!SOUL.md
!MEMORY.md
!USER.md
!AGENTS.md
!CLAUDE.md
!.cursorrules
!system_prompt.md
!config.yaml
!profile.yaml
!desktop.json
!ui-preferences.json
!todo.json
!/skills/
!/skills/**
!/memories/
!/memories/**
!/knowledge/
!/knowledge/**
!/preferences/
!/preferences/**
!/hooks/
!/hooks/**
!/scripts/
!/scripts/**
!/plugins/
!/plugins/**
!/skins/
!/skins/**
!/cron/
!/cron/jobs.json
!/profiles/
!/profiles/coder/
!/profiles/coder/skills/
!/profiles/coder/skills/**
!/profiles/coder/memories/
!/profiles/coder/memories/**
!/profiles/coder/knowledge/
!/profiles/coder/knowledge/**
!/profiles/coder/preferences/
!/profiles/coder/preferences/**
!/profiles/coder/hooks/
!/profiles/coder/hooks/**
!/profiles/coder/scripts/
!/profiles/coder/scripts/**
!/profiles/coder/plugins/
!/profiles/coder/plugins/**
!/profiles/coder/skins/
!/profiles/coder/skins/**
!/profiles/coder/cron/
!/profiles/coder/cron/jobs.json

# Credentials and generated files also stay out of allowed directories.
**/.env*
**/auth.json
**/credentials*.json
**/*token*.json
**/.netrc
**/.npmrc
**/.pypirc
**/.ssh/
**/.git/
**/.locks/
**/.usage.json
**/__pycache__/
**/node_modules/
**/venv/
**/.venv/
*.lock
*.jsonl
*.pyc
*.pem
*.key
*.p12
*.db
*.sqlite

# Track workspace-wide instructions without project checkouts.
!/workspace/
/workspace/*
!/workspace/.hermes.md

# Cluster-managed plugins stay in the homelab repository.
**/plugins/advanced-delegation/
**/plugins/langfuse/
