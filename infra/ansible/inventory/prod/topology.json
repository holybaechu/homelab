{
  "all": {
    "vars": {
      "ansible_user": "root",
      "pve_bridge": "vmbr0",
      "pve_root_datastore_id": "local-lvm",
      "pve_lxc_nameservers": [
        "192.168.0.3",
        "1.1.1.1"
      ],
      "pve_lxc_searchdomain": "home.hchu.me"
    },
    "children": {
      "pve_hosts": {
        "hosts": {
          "pve": {
            "ansible_host": "192.168.0.2",
            "deployment_unit": "pve"
          }
        }
      },
      "debian": {
        "hosts": {
          "tailnet": {
            "ansible_host": "192.168.0.4",
            "deployment_unit": "tailnet",
            "vmid": 111,
            "hostname": "tailnet",
            "description": "Tailscale subnet router and exit node managed by Ansible",
            "lxc_tags": [
              "homelab",
              "managed-by-ansible",
              "role-tailnet"
            ],
            "template_file_id": "local:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst",
            "os_type": "debian",
            "prefix_length": 24,
            "mac_address": "02:00:00:BA:EC:04",
            "gateway": "192.168.0.1",
            "root_disk_gb": 4,
            "cores": 1,
            "memory_mb": 512,
            "swap_mb": 0,
            "startup_order": 1,
            "unprivileged": true,
            "lxc_features": {
              "nesting": true,
              "keyctl": true
            },
            "lxc_devices": {
              "dev0": "/dev/net/tun,mode=0666"
            },
            "lxc_mounts": {}
          },
          "docker_apps": {
            "ansible_host": "192.168.0.3",
            "deployment_unit": "apps-host",
            "vmid": 110,
            "hostname": "docker-apps",
            "description": "Docker Compose host for all homelab application services managed by Ansible",
            "lxc_tags": [
              "homelab",
              "managed-by-ansible",
              "role-docker-apps"
            ],
            "template_file_id": "local:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst",
            "os_type": "debian",
            "prefix_length": 24,
            "mac_address": "02:00:00:BA:EC:03",
            "gateway": "192.168.0.1",
            "root_disk_gb": 32,
            "cores": 6,
            "memory_mb": 8192,
            "swap_mb": 2048,
            "startup_order": 2,
            "unprivileged": true,
            "lxc_features": {
              "nesting": true,
              "keyctl": true
            },
            "lxc_devices": {},
            "lxc_mounts": {
              "mp0": {
                "source": "/var/lib/homelab",
                "target": "/srv/homelab",
                "source_owner": 0,
                "source_group": 0,
                "source_mode": "0755"
              }
            }
          },
          "openclaw": {
            "ansible_host": "192.168.0.5",
            "deployment_unit": "openclaw-host",
            "vmid": 118,
            "hostname": "openclaw",
            "description": "Dedicated immutable OpenClaw Gateway and CTF runtime managed by Ansible",
            "lxc_tags": [
              "homelab",
              "managed-by-ansible",
              "role-openclaw"
            ],
            "template_file_id": "local:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst",
            "os_type": "debian",
            "prefix_length": 24,
            "mac_address": "02:00:00:BA:EC:05",
            "gateway": "192.168.0.1",
            "root_disk_gb": 96,
            "cores": 8,
            "memory_mb": 12288,
            "swap_mb": 3072,
            "startup_order": 3,
            "unprivileged": true,
            "lxc_features": {
              "nesting": true,
              "keyctl": true
            },
            "lxc_devices": {},
            "lxc_mounts": {
              "mp0": {
                "source": "/var/lib/homelab/openclaw-ctf",
                "target": "/var/lib/openclaw/workspaces/ctf",
                "source_owner": 101000,
                "source_group": 101000,
                "source_mode": "0700"
              }
            }
          }
        }
      },
      "svc_tailnet": {
        "hosts": {
          "tailnet": {}
        }
      },
      "svc_docker_apps": {
        "hosts": {
          "docker_apps": {}
        }
      },
      "svc_openclaw": {
        "hosts": {
          "openclaw": {}
        }
      }
    }
  }
}
