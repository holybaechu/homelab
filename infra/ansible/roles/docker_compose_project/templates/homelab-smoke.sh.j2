#!/bin/sh
set -eu

fail() {
  printf 'homelab smoke failed: %s\n' "$*" >&2
  exit 1
}

[ "$(id -u)" -eq 0 ] || fail "root execution is required"
case "${HOMELAB_PROJECT:-}" in homelab) ;; *) fail "invalid project identity" ;; esac
case "${HOMELAB_RELEASE_SHA:-}" in
  *[!0-9a-f]*|'') fail "invalid release identity" ;;
esac
sha_length=$(printf '%s' "$HOMELAB_RELEASE_SHA" | wc -c | tr -d ' ')
[ "$sha_length" -eq 40 ] || [ "$sha_length" -eq 64 ] \
  || fail "invalid release identity length"
[ -d "${HOMELAB_PROJECT_DIR:-}" ] || fail "project directory is unavailable"

compose() {
  docker compose \
    --project-name "$HOMELAB_PROJECT" \
    --project-directory "$HOMELAB_PROJECT_DIR" \
    --env-file "$HOMELAB_PROJECT_DIR/.env" \
    --env-file "$HOMELAB_PROJECT_DIR/.homelab/artifacts.env" \
    -f "$HOMELAB_PROJECT_DIR/compose.yml" \
    "$@"
}

expected_services=$(printf '%s\n' \
  traefik adguard cloudflare-ddns qbittorrent copyparty metube t3code \
  | LC_ALL=C sort)
running_services=$(compose ps --services --status running | LC_ALL=C sort)
[ "$running_services" = "$expected_services" ] \
  || fail "running service set differs from the release contract"

for service in traefik adguard cloudflare-ddns qbittorrent copyparty metube t3code; do
  set -- $(compose ps -q "$service")
  [ "$#" -eq 1 ] || fail "$service has no unique container"
  container_id=$1
  state=$(docker inspect --format \
    '{% raw %}{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}{% endraw %}' \
    "$container_id")
  if [ "$service" = cloudflare-ddns ]; then
    [ "$state" = "running none" ] || fail "$service process is not running"
    restart_count=$(docker inspect --format '{% raw %}{{.RestartCount}}{% endraw %}' "$container_id")
    [ "$restart_count" = 0 ] || fail "$service restarted during activation"
  else
    [ "$state" = "running healthy" ] || fail "$service is not healthy"
  fi
done

dns_name="{{ t3code_hostname }}"
dns_expected="{{ hostvars['docker_apps'].ansible_host }}"
dns_answers=$(dig +short +time=3 +tries=1 @127.0.0.1 "$dns_name" A)
printf '%s\n' "$dns_answers" | grep -Fqx "$dns_expected" \
  || fail "AdGuard did not return the managed private address for $dns_name"

probe_ingress() {
  hostname=$1
  attempt=1
  while [ "$attempt" -le 10 ]; do
    if curl --fail --silent --show-error --max-time 8 --output /dev/null \
      --resolve "$hostname:443:127.0.0.1" "https://$hostname/"
    then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 2
  done
  fail "shared ingress route failed for $hostname"
}

for hostname in \
  adguard.{{ traefik_private_domain }} \
  qbt.{{ traefik_private_domain }} \
  copyparty.{{ traefik_domain }} \
  metube.{{ traefik_private_domain }} \
  {{ t3code_hostname }}
do
  probe_ingress "$hostname"
done

printf 'homelab smoke passed for %s at %s\n' \
  "$HOMELAB_PROJECT" "$HOMELAB_RELEASE_SHA"
