[Preferences]
WebUI\Address=0.0.0.0
WebUI\Port=8080
WebUI\Username={{ qbittorrent_webui_username }}
WebUI\Password_PBKDF2="{{ qbittorrent_webui_password_pbkdf2 }}"
WebUI\LocalHostAuth=false
WebUI\AlternativeUIEnabled=true
WebUI\RootFolder=/vuetorrent
Downloads\SavePath=/downloads/complete/
Downloads\TempPath=/downloads/incomplete/
Downloads\TempPathEnabled=true
{% if qbittorrent_instance.connection_interface | length > 0 %}
Connection\Interface={{ qbittorrent_instance.connection_interface }}
{% endif %}
Connection\PortRangeMin={{ qbittorrent_instance.peer_port }}
Connection\UPnP=false
Connection\RandomPort=false

[BitTorrent]
Session\QueueingSystemEnabled=false
