[Unit]
Description=Promote autonomous OpenClaw skills into the protected setup repository
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ openclaw_skill_sync_user }}
Group={{ openclaw_skill_sync_group }}
WorkingDirectory={{ openclaw_skill_sync_state_root }}
LoadCredential=github_token:{{ openclaw_skill_sync_github_token_path }}
Environment=OPENCLAW_SKILL_SYNC_GITHUB_TOKEN_FILE=%d/github_token
Environment=OPENCLAW_SKILL_SYNC_STATE_ROOT={{ openclaw_skill_sync_state_root }}
Environment=OPENCLAW_SKILL_SYNC_MAIN_ROOT={{ openclaw_workspace_root }}/skills
Environment=OPENCLAW_SKILL_SYNC_CTF_ROOT={{ openclaw_ctf_workspace_root }}/skills
Environment=OPENCLAW_SKILL_SYNC_REPOSITORY={{ openclaw_skill_sync_repository }}
Environment=OPENCLAW_SKILL_SYNC_DEPLOY_REPOSITORY={{ openclaw_skill_sync_deploy_repository }}
Environment=OPENCLAW_SKILL_SYNC_ASKPASS={{ openclaw_skill_sync_askpass_path }}
Environment=OPENCLAW_SKILL_SYNC_CHECK_TIMEOUT={{ openclaw_skill_sync_check_timeout }}
Environment=OPENCLAW_SKILL_SYNC_SKILL_UID={{ openclaw_uid }}
Environment=HOME={{ openclaw_skill_sync_state_root }}
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 {{ openclaw_skill_sync_script_path }}
TimeoutStartSec=1200
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths={{ openclaw_workspace_root }}/skills
ReadOnlyPaths={{ openclaw_ctf_workspace_root }}/skills
ReadWritePaths={{ openclaw_skill_sync_state_root }}
StandardOutput=journal
StandardError=journal
