[Unit]
Description=Validate the OpenClaw systemd credential contract

[Service]
Type=oneshot
User={{ openclaw_user }}
Group={{ openclaw_group }}
UMask=0077
LimitCORE=0
RuntimeDirectory=openclaw-credential-probe
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
LoadCredential=openclaw_gateway_token:{{ openclaw_gateway_token_path }}
LoadCredential=discord_bot_token:{{ openclaw_discord_bot_token_path }}
ExecStartPre=/usr/local/libexec/materialize-openclaw-credential %d/openclaw_gateway_token /run/openclaw-credential-probe/gateway_token
ExecStartPre=/usr/local/libexec/materialize-openclaw-credential %d/discord_bot_token /run/openclaw-credential-probe/discord_bot_token
ExecStart=/usr/bin/true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
