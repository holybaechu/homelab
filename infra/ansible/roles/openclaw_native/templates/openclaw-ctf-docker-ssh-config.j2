# Managed by Ansible. Docker's Codex subprocess may normalize PATH and bypass
# the service-private ssh shim, so the system OpenSSH client must retain the
# same exact host pin and dedicated identity for this one endpoint.
Host {{ ctf_executor_ip }}
  User {{ openclaw_ctf_docker_user }}
  BatchMode yes
  IdentitiesOnly yes
  StrictHostKeyChecking yes
  UserKnownHostsFile {{ openclaw_ctf_docker_known_hosts_path }}
  GlobalKnownHostsFile /dev/null
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  PreferredAuthentications publickey
  IdentityAgent none
  IdentityFile /run/openclaw-gateway/ctf_docker_client_key
  ClearAllForwardings yes
  RequestTTY no
