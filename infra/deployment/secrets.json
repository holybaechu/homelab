{
  "version": 1,
  "components": [
    "apps",
    "tailnet",
    "openclaw"
  ],
  "entries": [
    {
      "github_env": "CLOUDFLARE_TRAEFIK_TOKEN",
      "ansible_variable": "cloudflare_traefik_token",
      "component": "apps",
      "kind": "required",
      "validation": "nonempty"
    },
    {
      "github_env": "CLOUDFLARE_DDNS_TOKEN",
      "ansible_variable": "cloudflare_ddns_token",
      "component": "apps",
      "kind": "required",
      "validation": "nonempty"
    },
    {
      "github_env": "ADGUARD_ADMIN_PASSWORD",
      "ansible_variable": "adguard_admin_password",
      "component": "apps",
      "kind": "required",
      "validation": "nonempty"
    },
    {
      "github_env": "QBITTORRENT_WEBUI_PASSWORD",
      "ansible_variable": "qbittorrent_webui_password",
      "component": "apps",
      "kind": "required",
      "validation": "nonempty"
    },
    {
      "github_env": "COPYPARTY_USERS_JSON",
      "ansible_variable": "copyparty_users",
      "component": "apps",
      "kind": "required",
      "validation": "copyparty_users_json"
    },
    {
      "github_env": "ADGUARD_ADMIN_USERNAME",
      "ansible_variable": "adguard_admin_username",
      "component": "apps",
      "kind": "optional",
      "validation": "nonempty"
    },
    {
      "github_env": "TAILSCALE_AUTH_KEY",
      "ansible_variable": "tailscale_auth_key",
      "component": "tailnet",
      "kind": "required",
      "validation": "nonempty"
    },
    {
      "github_env": "OPENCLAW_GATEWAY_TOKEN",
      "ansible_variable": "openclaw_gateway_token",
      "component": "openclaw",
      "kind": "required",
      "validation": "hex_64"
    },
    {
      "github_env": "OPENCLAW_DISCORD_BOT_TOKEN",
      "ansible_variable": "openclaw_discord_bot_token",
      "component": "openclaw",
      "kind": "required",
      "validation": "nonempty"
    },
    {
      "github_env": "OPENCLAW_EXA_API_KEY",
      "ansible_variable": "openclaw_exa_api_key",
      "component": "openclaw",
      "kind": "required",
      "validation": "non_whitespace_1_4096"
    },
    {
      "github_env": "OPENCLAW_SKILL_SYNC_GITHUB_TOKEN",
      "ansible_variable": "openclaw_skill_sync_github_token",
      "component": "openclaw",
      "kind": "required",
      "validation": "non_whitespace_20_4096"
    }
  ]
}
