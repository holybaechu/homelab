http:
  middlewares:
    clear-copyparty-identity:
      headers:
        customRequestHeaders:
          X-authentik-username: ""
          X-authentik-groups: ""
          X-authentik-email: ""
          X-authentik-name: ""
          X-authentik-uid: ""
    authentik:
      forwardAuth:
        address: http://authentik-server:9000/outpost.goauthentik.io/auth/traefik
        trustForwardHeader: true
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-email
          - X-authentik-name
          - X-authentik-uid
    private-only:
      ipAllowList:
        sourceRange:
          - 192.168.0.0/24
          - 100.64.0.0/10
          - 172.16.0.0/12
    secure-headers:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: true
        referrerPolicy: no-referrer-when-downgrade
        contentTypeNosniff: true
        customFrameOptionsValue: DENY
    pve-headers:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: true
        referrerPolicy: no-referrer-when-downgrade
        contentTypeNosniff: true
        customFrameOptionsValue: SAMEORIGIN
    router-headers:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: true
        referrerPolicy: no-referrer-when-downgrade
        customFrameOptionsValue: DENY

  routers:
    adguard:
      rule: Host(`adguard.home.hchu.me`)
      entryPoints: [websecure]
      middlewares: [private-only, secure-headers]
      service: adguard
    pve:
      rule: Host(`pve.home.hchu.me`)
      entryPoints: [websecure]
      middlewares: [private-only, pve-headers]
      service: pve
      observability:
        accessLogs: false
    router:
      rule: Host(`router.home.hchu.me`)
      entryPoints: [websecure]
      middlewares: [private-only, router-headers]
      service: router

  services:
    adguard:
      loadBalancer:
        servers:
          - url: http://host.docker.internal:3000
    pve:
      loadBalancer:
        serversTransport: pve-transport
        servers:
          - url: https://@@PVE_HOST@@:8006
    router:
      loadBalancer:
        servers:
          - url: http://@@ROUTER_HOST@@

  serversTransports:
    pve-transport:
      serverName: pve.home.hchu.me
      rootCAs:
        - /etc/ssl/certs/homelab-pve-root-ca.pem
