#!/usr/bin/env python3
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

import yaml


ROOT = Path(__file__).resolve().parents[1]


def check(command, *, data=None, env=None):
    result = subprocess.run(command, cwd=ROOT, input=data, text=True, capture_output=True, env=env)
    if result.returncode:
        print(result.stderr or result.stdout, file=sys.stderr)
        raise RuntimeError(f"{' '.join(command)}: exit {result.returncode}")
    return result.stdout


def main():
    settings = yaml.safe_load((ROOT / "kubernetes/clusters/homelab/settings.yaml").read_text())["data"]
    environment = {"PATH": os.environ["PATH"], **{key: str(value) for key, value in settings.items()}}
    resources = []
    paths = ["bootstrap", "clusters/homelab", "platform/controllers", "platform/config", "identity", "apps", "access"]
    for path in paths:
        built = check(["kustomize", "build", f"kubernetes/{path}"])
        if path not in ("bootstrap", "clusters/homelab"):
            built = check(["flux", "envsubst", "--strict"], data=built, env=environment)
        resources.extend(item for item in yaml.safe_load_all(built) if item)
        print(f"Kustomize {path}: exit 0")

    repositories = {item["metadata"]["name"]: item["spec"]["url"] for item in resources if item["kind"] == "HelmRepository"}
    rendered = []
    for item in resources:
        if item["kind"] != "HelmRelease":
            continue
        spec = item["spec"]
        chart = spec["chart"]["spec"]
        result = check([
            "helm", "template", spec.get("releaseName", item["metadata"]["name"]), chart["chart"],
            "--repo", repositories[chart["sourceRef"]["name"]], "--version", str(chart["version"]),
            "--namespace", item["metadata"]["namespace"], "--kube-version", "1.37.1", "--include-crds", "-f", "-",
        ], data=yaml.safe_dump(spec.get("values", {})))
        rendered.extend(doc for doc in yaml.safe_load_all(result) if doc)
        print(f"Helm {item['metadata']['name']}: exit 0")

    all_resources = resources + rendered
    with tempfile.TemporaryDirectory(prefix="homelab-validation-") as directory:
        temporary = Path(directory)
        for item in all_resources:
            if item["kind"] != "CustomResourceDefinition":
                continue
            spec = item["spec"]
            for version in spec["versions"]:
                schema = version.get("schema", {}).get("openAPIV3Schema")
                if schema:
                    folder = temporary / spec["group"]
                    folder.mkdir(exist_ok=True)
                    name = spec["names"]["kind"].lower() + "_" + version["name"] + ".json"
                    (folder / name).write_text(json.dumps(schema))
        # The Helm chart CRDs and Flux CRDs supply all custom resource schemas.
        validated = [item for item in all_resources if item["kind"] != "CustomResourceDefinition"]
        output = check([
            "kubeconform", "-strict", "-summary", "-kubernetes-version", "1.37.1",
            "-schema-location", "default", "-schema-location", str(temporary / "{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json"),
        ], data=yaml.safe_dump_all(validated))
        print(output, end="")
        artifact = temporary / "resources.json"
        artifact.write_text(json.dumps(resources))
        env = dict(os.environ, HOMELAB_RENDERED=str(artifact))
        check([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-v"], env=env)
        print("Regression suite: exit 0")
        tf_env = dict(os.environ, TF_DATA_DIR=str(temporary / "tofu"), TF_IN_AUTOMATION="1")
        check(["tofu", "-chdir=infra/talos", "fmt", "-check"])
        check(["tofu", "-chdir=infra/talos", "init", "-backend=false", "-input=false"], env=tf_env)
        check(["tofu", "-chdir=infra/talos", "validate"], env=tf_env)
        print("OpenTofu format/init/validate: exit 0")
    check(["git", "diff", "--check"])
    print("Diff whitespace: exit 0")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError) as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(1)
