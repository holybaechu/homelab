#!/usr/bin/env python3
import argparse
import base64
import hashlib
import json
import os
from pathlib import Path
import secrets
import shutil
import subprocess
import sys
import time

import yaml


ROOT = Path(__file__).resolve().parents[1]
SETTINGS = ROOT / "kubernetes/clusters/homelab/settings.yaml"


def run(command, *, payload=None, timeout=300):
    if not shutil.which(command[0]):
        raise RuntimeError(f"Missing prerequisite: {command[0]}; install the tools from mise.toml")
    result = subprocess.run(command, input=payload, capture_output=True, text=True, timeout=timeout)
    if result.returncode:
        # op and kubectl can include private values in diagnostics.
        raise RuntimeError(f"{command[0]} {command[1]} failed (exit {result.returncode}); inspect the service status locally")
    return result.stdout


def apply(document):
    return run(["kubectl", "apply", "--server-side", "--field-manager=homelab-bootstrap", "-f", "-"], payload=json.dumps(document))


def onepassword_item(settings):
    return json.loads(run(["op", "item", "get", "homelab", "--vault", settings["ONEPASSWORD_VAULT"], "--format=json"]))


def prepare_secrets(args, settings):
    import bcrypt
    from getpass import getpass

    items = json.loads(run(["op", "item", "list", "--vault", settings["ONEPASSWORD_VAULT"], "--format=json"]))
    if any(item["title"] == "homelab" for item in items):
        raise RuntimeError("The homelab item already exists; this command will not rotate or overwrite it")
    cloudflare_dns = getpass("Cloudflare DNS API token: ")
    cloudflare_ddns = getpass("Cloudflare DDNS API token (Enter to reuse the DNS token): ") or cloudflare_dns
    if not cloudflare_dns:
        raise RuntimeError("A Cloudflare DNS API token is required")
    adguard_password = secrets.token_urlsafe(24)
    qbt_password = secrets.token_urlsafe(24)
    salt = secrets.token_bytes(16)
    derived = hashlib.pbkdf2_hmac("sha512", qbt_password.encode(), salt, 100000, 64)
    values = {
        "cloudflare_dns_token": cloudflare_dns,
        "cloudflare_ddns_token": cloudflare_ddns,
        "authentik_secret_key": secrets.token_urlsafe(64),
        "authentik_database_password": secrets.token_urlsafe(32),
        "authentik_bootstrap_email": args.email,
        "authentik_bootstrap_password": secrets.token_urlsafe(24),
        "headscale_oidc_client_secret": secrets.token_urlsafe(32),
        "headscale_gateway_authkey": "",
        "adguard_username": "admin",
        "adguard_password": adguard_password,
        "adguard_password_hash": bcrypt.hashpw(adguard_password.encode(), bcrypt.gensalt()).decode(),
        "qbittorrent_username": "admin",
        "qbittorrent_password": qbt_password,
        "qbittorrent_password_hash": "@ByteArray(" + base64.b64encode(salt).decode() + ":" + base64.b64encode(derived).decode() + ")",
        "copyparty_username": "owner",
        "copyparty_password": secrets.token_urlsafe(24),
        "opentofu_state_passphrase": secrets.token_urlsafe(48),
    }
    item = {
        "title": "homelab",
        "category": "SECURE_NOTE",
        "fields": [{"label": name, "type": "CONCEALED", "value": value} for name, value in values.items()],
    }
    run(["op", "item", "create", "--vault", settings["ONEPASSWORD_VAULT"], "--format=json", "-"], payload=json.dumps(item))
    print("Created the homelab item in 1Password. No credentials were written to Git or printed.")


def check_context(settings):
    kubeconfig = os.environ.get("KUBECONFIG", "")
    if not kubeconfig or os.pathsep in kubeconfig:
        raise RuntimeError("Set KUBECONFIG to the external kubeconfig exported by scripts/talos")
    path = Path(kubeconfig).expanduser().resolve()
    if not path.is_file() or path == ROOT or ROOT in path.parents or path.stat().st_mode & 0o077:
        raise RuntimeError("KUBECONFIG must be a private file outside the repository")
    context = json.loads(run(["kubectl", "config", "view", "--minify", "-o", "json"]))
    server = context["clusters"][0]["cluster"]["server"]
    if server != f"https://{settings['NODE_IP']}:6443":
        raise RuntimeError("The selected Kubernetes context does not match the declared node")


def bootstrap(args, settings):
    token = os.environ.get("OP_SERVICE_ACCOUNT_TOKEN", "")
    if not token:
        raise RuntimeError("Set OP_SERVICE_ACCOUNT_TOKEN to a 1Password service account with access to the Homelab vault")
    if not args.git_ref or args.git_ref.startswith("-"):
        raise RuntimeError("An explicit published Git branch is required")
    run(["git", "ls-remote", "--exit-code", "--heads", "https://github.com/holybaechu/homelab.git", "refs/heads/" + args.git_ref], timeout=30)
    check_context(settings)
    apply({"apiVersion": "v1", "kind": "Namespace", "metadata": {"name": "flux-system"}})
    apply({"apiVersion": "v1", "kind": "Namespace", "metadata": {"name": "external-secrets"}})
    apply({"apiVersion": "v1", "kind": "Secret", "metadata": {"name": "onepassword-token", "namespace": "external-secrets"}, "type": "Opaque", "data": {"token": base64.b64encode(token.encode()).decode()}})
    apply(yaml.safe_load(SETTINGS.read_text()))
    run(["kubectl", "apply", "--server-side", "--field-manager=homelab-bootstrap", "-k", str(ROOT / "kubernetes/bootstrap")], timeout=600)
    run(["kubectl", "wait", "--for=condition=Established", "--timeout=120s", "crd/gitrepositories.source.toolkit.fluxcd.io", "crd/kustomizations.kustomize.toolkit.fluxcd.io"])
    apply({
        "apiVersion": "source.toolkit.fluxcd.io/v1", "kind": "GitRepository",
        "metadata": {"name": "homelab", "namespace": "flux-system"},
        "spec": {"interval": "1m", "url": "https://github.com/holybaechu/homelab.git", "ref": {"branch": args.git_ref}},
    })
    apply({
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1", "kind": "Kustomization",
        "metadata": {"name": "homelab", "namespace": "flux-system"},
        "spec": {"interval": "10m", "retryInterval": "1m", "path": "./kubernetes/clusters/homelab", "prune": False, "sourceRef": {"kind": "GitRepository", "name": "homelab"}},
    })
    print("Flux bootstrap submitted. Inspect scripts/cluster status; access becomes ready after gateway registration.")


def register_gateway(settings):
    check_context(settings)
    item = onepassword_item(settings)
    command = ["kubectl", "-n", "identity", "exec", "deploy/headscale", "--", "headscale"]
    users = json.loads(run([*command, "users", "list", "--name", "gateway", "--output", "json"]))
    if len(users) > 1:
        raise RuntimeError("Headscale has multiple gateway users")
    user = users[0] if users else json.loads(run([*command, "users", "create", "gateway", "--output", "json"]))
    result = json.loads(run([*command, "preauthkeys", "create", "--user", str(user["id"]), "--tags", "tag:gateway", "--expiration", "1h", "--output", "json"]))
    fields = [field for field in item["fields"] if field.get("label") == "headscale_gateway_authkey"]
    if len(fields) != 1:
        raise RuntimeError("1Password must contain exactly one headscale_gateway_authkey field")
    fields[0]["value"] = result["key"]
    run(["op", "item", "edit", item["id"], "--vault", settings["ONEPASSWORD_VAULT"], "--format=json"], payload=json.dumps(item))
    run(["kubectl", "-n", "networking", "annotate", "externalsecret/headscale-gateway", "force-sync=" + str(time.time_ns()), "--overwrite"])
    print("Saved a one-hour, single-use gateway key in 1Password and requested ESO refresh.")


def main():
    parser = argparse.ArgumentParser()
    commands = parser.add_subparsers(dest="command", required=True)
    prepare = commands.add_parser("prepare-secrets")
    prepare.add_argument("--email", required=True)
    boot = commands.add_parser("bootstrap")
    boot.add_argument("--git-ref", required=True)
    commands.add_parser("gateway")
    commands.add_parser("status")
    args = parser.parse_args()
    settings = yaml.safe_load(SETTINGS.read_text())["data"]
    if args.command == "prepare-secrets":
        prepare_secrets(args, settings)
    elif args.command == "bootstrap":
        bootstrap(args, settings)
    elif args.command == "gateway":
        register_gateway(settings)
    else:
        check_context(settings)
        print(run(["flux", "get", "all", "--all-namespaces"]), end="")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, ValueError, KeyError, subprocess.TimeoutExpired) as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(1)
